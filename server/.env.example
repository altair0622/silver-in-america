# 이 파일을 server/.env 로 복사하고 값을 채운다. server/.env 는 git 에 올라가지 않는다.
# Plaid 대시보드(https://dashboard.plaid.com) → Developers → Keys 에서 확인
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox(가짜 은행 시험) 또는 production(실제 은행). secret 은 환경마다 다르다.
PLAID_ENV=sandbox
# 은행 접근 토큰 암호화 키(64자리 16진수). 아래 명령으로 만든다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_KEY=
PORT=8787
